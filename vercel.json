{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js_cote_navigateur/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/style.css", "dest": "css/style.css" },
    { "src": "/javascrit.js", "dest": "js_cote_navigateur/javascrit.js" },
    { "src": "/(.*\\.(?:css|png|jpg|jpeg|gif|svg|webp|js))", "dest": "$0" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
