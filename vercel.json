{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "../css/**, ../js_cote_navigateur/**"
    }
  },
  "rewrites": [
    {
      "source": "/css/(.*)",
      "destination": "/css/$1"
    },
    {
      "source": "/js_cote_navigateur/(.*)",
      "destination": "/js_cote_navigateur/$1"
    }
  ]
}