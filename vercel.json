{
    "version": 2,
    "builds": [
        {
            "src" : "index.js",
            "use" : "@vercel/node"
        }
    ],
    "routes" : [
        {
            "src" : "/css/(.*)",
            "dest" : "/css/$1"
        },
        {
            "src" : "/js_cote_naviggateur/(.*)",
            "dest" : "/js_cote_naviggateur/$1"     
        },
        {
            "src" : "/(.*)",
            "dest" : "/api/index.js"              
        }
    ]
}